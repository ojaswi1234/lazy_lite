{
  "mcpServers": {
    "google-workspace": {
      "command": "python",
      "args": [
        "-m",
        "google_workspace_mcp"
      ],
      "env": {
        "GOOGLE_WORKSPACE_CLIENT_ID": "",
        "GOOGLE_WORKSPACE_CLIENT_SECRET": "",
        "GOOGLE_WORKSPACE_REFRESH_TOKEN": ""
      }
    },
    "@modelcontextprotocol/server-github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      }
    },
    "rea-agents": {
      "command": "npx",
      "args": [
        "-y",
        "rea-agents",
        "--mcp"
      ],
      "env": {}
    }
  }
}